#define ZMK_POINTING_DEFAULT_MOVE_VAL 1250
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define HT_PRIOR_IDLE 150
#define HT_TAPPING_TERM 280
#define HT_QUICK_TAP 175
#define KEYS_L_TOP  0  1  2  3  4
#define KEYS_R_TOP  5  6  7  8  9
#define KEYS_L_MID 10 11 12 13 14
#define KEYS_R_MID 15 16 17 18 19
#define KEYS_L_BTM 20 21 22 23 24
#define KEYS_R_BTM 25 26 27 28 29
#define KEYS_L_THUMB 30 31 32
#define KEYS_R_THUMB 33 34
#define KEYS_L KEYS_L_TOP KEYS_L_MID KEYS_L_BTM
#define KEYS_R KEYS_R_TOP KEYS_R_MID KEYS_R_BTM
#define KEYS_THUMBS KEYS_L_THUMB KEYS_R_THUMB

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&sl { release-after-ms = <2000>; };

/ {
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <HT_PRIOR_IDLE>;
            tapping-term-ms = <HT_TAPPING_TERM>;
            quick-tap-ms = <HT_QUICK_TAP>;
            bindings = <&mo>, <&kp>;

            display-name = "Layer-Tap";
        };

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <HT_PRIOR_IDLE>;
            tapping-term-ms = <HT_TAPPING_TERM>;
            quick-tap-ms = <HT_QUICK_TAP>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
            hold-trigger-on-release;
            display-name = "Mod-Tap Home-Mode Left";
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <HT_PRIOR_IDLE>;
            tapping-term-ms = <HT_TAPPING_TERM>;
            quick-tap-ms = <HT_QUICK_TAP>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
            hold-trigger-on-release;
            display-name = "Mod-Tap Home-Mode Right";
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    combos {
        compatible = "zmk,combos";

        system_left {
            bindings = <&sl 10>;
            key-positions = <0 2 4>;
            layers = <0 1>;
        };

        system_right {
            bindings = <&sl 10>;
            key-positions = <5 7 9>;
            layers = <0 1>;
        };

        utils {
            bindings = <&sl 11>;
            key-positions = <4 5>;
            layers = <0 1>;
        };

        key_lbkt {
            bindings = <&kp LBKT>;
            key-positions = <2 3>;
            layers = <0 1>;
        };

        key_rbkt {
            bindings = <&kp RBKT>;
            key-positions = <6 7>;
            layers = <0 1>;
        };

        key_lbrc {
            bindings = <&kp LBRC>;
            key-positions = <22 23>;
            layers = <0 1>;
        };

        key_rbrc {
            bindings = <&kp RBRC>;
            key-positions = <26 27>;
            layers = <0 1>;
        };

        key_lt {
            bindings = <&kp LT>;
            key-positions = <1 2>;
            layers = <0 1>;
        };

        key_gt {
            bindings = <&kp GT>;
            key-positions = <7 8>;
            layers = <0 1>;
        };

        key_lpar {
            bindings = <&kp LPAR>;
            key-positions = <21 22>;
            layers = <0 1>;
        };

        key_rpar {
            bindings = <&kp RPAR>;
            key-positions = <27 28>;
            layers = <0 1>;
        };

        key_grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
            layers = <0 1>;
        };

        key_bslh {
            bindings = <&kp BSLH>;
            key-positions = <8 9>;
            layers = <0 1>;
        };

        key_tilde {
            bindings = <&kp TILDE>;
            key-positions = <20 21>;
            layers = <0 1>;
        };

        key_pipe {
            bindings = <&kp PIPE>;
            key-positions = <28 29>;
            layers = <0 1>;
        };

        key_del {
            bindings = <&kp DEL>;
            key-positions = <33 34>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&kp Q         &kp W         &kp E          &kp R          &kp T           &kp Y         &kp U          &kp I          &kp O         &kp P
&hm_l LGUI A  &hm_l LALT S  &hm_l LSHFT D  &hm_l LCTRL F  &hm_l RALT G    &hm_r RALT H  &hm_r RCTRL J  &hm_r RSHFT K  &hm_r LALT L  &hm_r RGUI SEMI
&lt 7 Z       &kp X         &kp C          &kp V          &kp B           &kp N         &kp M          &kp COMMA      &kp DOT       &lt 7 SLASH
                            &lt 6 ESC      &lt 5 SPACE    &lt 4 TAB       &lt 2 RET     &lt 3 BSPC
            >;
        };

        cmkdh_layer {
            display-name = "Cmk-DH";
            bindings = <
&kp Q         &kp W         &kp F          &kp P          &kp B           &kp J         &kp L          &kp U          &kp Y         &kp SEMI
&hm_l LGUI A  &hm_l LALT R  &hm_l LSHFT S  &hm_l LCTRL T  &hm_l RALT G    &hm_r RALT M  &hm_r RCTRL N  &hm_r RSHFT E  &hm_r LALT I  &hm_r RGUI O
&lt 7 Z       &kp X         &kp C          &kp D          &kp V           &kp K         &kp H          &kp COMMA      &kp DOT       &lt 7 SLASH
                            &trans         &trans         &trans          &trans        &trans
            >;
        };

        symbol_layer {
            display-name = "Symbol";
            bindings = <
&kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC     &none     &none      &none      &none     &none
&kp DQT    &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS     &sk RALT  &sk RCTRL  &sk RSHFT  &sk LALT  &sk RGUI
&kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE     &none     &none      &none      &none     &none
                     &kp GT     &kp RPAR   &kp UNDER    &none     &none
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
&kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &none     &none      &none      &none     &none
&kp SQT    &kp N4  &kp N5   &kp N6  &kp EQUAL    &sk RALT  &sk RCTRL  &sk RSHFT  &sk LALT  &sk RGUI
&kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &none     &none      &none      &none     &none
                   &kp DOT  &kp N0  &kp MINUS    &none     &none
            >;
        };

        func_layer {
            display-name = "Func";
            bindings = <
&none     &none     &none      &none      &none       &kp PSCRN        &kp F7         &kp F8  &kp F9  &kp F12
&sk LGUI  &sk LALT  &sk LSHFT  &sk LCTRL  &sk RALT    &kp SLCK         &kp F4         &kp F5  &kp F6  &kp F11
&none     &none     &none      &none      &none       &kp PAUSE_BREAK  &kp F1         &kp F2  &kp F3  &kp F10
                    &none      &none      &none       &kp RET          &kp BACKSPACE
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&none     &none     &none      &none      &none       &none     &none          &none      &none      &none
&sk LGUI  &sk LALT  &sk LSHFT  &sk LCTRL  &sk RALT    &kp CAPS  &kp LEFT       &kp DOWN   &kp UP     &kp RIGHT
&none     &none     &none      &none      &none       &kp INS   &kp HOME       &kp PG_DN  &kp PG_UP  &kp END
                    &none      &none      &none       &kp RET   &kp BACKSPACE
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&none     &none     &none      &none      &none       &none         &none         &none         &none         &none
&sk LGUI  &sk LALT  &sk LSHFT  &sk LCTRL  &sk RALT    &none         &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT
&none     &none     &none      &none      &none       &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
                    &none      &none      &none       &kp C_STOP    &kp C_PP
            >;
        };

        pointer_layer {
            display-name = "Pointer";
            bindings = <
&none     &none     &none      &none      &none       &none      &none      &none      &none     &none
&sk LGUI  &sk LALT  &sk LSHFT  &sk LCTRL  &sk RALT    &sk RALT   &sk RCTRL  &sk RSHFT  &sk LALT  &sk RGUI
&none     &mo 8     &mo 9      &none      &none       &none      &none      &mo 9      &mo 8     &none
                    &mkp MB2   &mkp MB1   &mkp MB3    &mkp RCLK  &mkp LCLK
            >;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans    &trans  &trans
            >;
        };

        sniper_layer {
            display-name = "Sniper";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans    &trans  &trans
            >;
        };

        system_layer {
            display-name = "System";
            bindings = <
&tog 1  &none  &bt BT_CLR_ALL  &none  &bootloader       &bootloader     &none  &bt BT_CLR_ALL  &none  &tog 1
&none   &none  &bt BT_CLR      &none  &sys_reset        &sys_reset      &none  &bt BT_CLR      &none  &none
&none   &none  &none           &none  &studio_unlock    &studio_unlock  &none  &none           &none  &none
               &none           &none  &none             &none           &none
            >;
        };

        utils_layer {
            display-name = "Utils";
            bindings = <
&none               &kp LS(LA(LC(N7)))  &kp LS(LA(LC(N8)))  &kp LS(LA(LC(N9)))  &none    &none  &kp LS(LA(LC(N7)))  &kp LS(LA(LC(N8)))  &kp LS(LA(LC(N9)))  &none
&none               &kp LS(LA(LC(N4)))  &kp LS(LA(LC(N5)))  &kp LS(LA(LC(N6)))  &none    &none  &kp LS(LA(LC(N4)))  &kp LS(LA(LC(N5)))  &kp LS(LA(LC(N6)))  &none
&kp LS(LA(LC(N0)))  &kp LS(LA(LC(N1)))  &kp LS(LA(LC(N2)))  &kp LS(LA(LC(N3)))  &none    &none  &kp LS(LA(LC(N1)))  &kp LS(LA(LC(N2)))  &kp LS(LA(LC(N3)))  &kp LS(LA(LC(N0)))
                                        &none               &none               &none    &none  &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
